{
  "expo": {
    "name": "TEGA Bus",
    "slug": "tega-bus-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/BusImage/logo.png",
    "scheme": "tegabus",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.tegabus.rwanda",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/BusImage/logo.png"
      },
      "usesCleartextTraffic": true,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/BusImage/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "TEGA Bus uses your photos so you can add a profile picture."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/BusImage/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#04325E"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/BusImage/logo.png",
          "color": "#0B3D66",
          "defaultChannel": "tega-alerts",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b4b30643-59ab-4396-b6e4-57b096ff77ba"
      }
    },
    "owner": "leopold05"
  }
}
